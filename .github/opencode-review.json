{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "agents": {
    "title": {
      "model": "opencode/deepseek-v4.1-flash"
    },
    "review": {
      "description": "Non-interactive pull request reviewer",
      "mode": "primary",
      "permissions": [
        {"action": "*", "resource": "*", "effect": "deny"},
        {"action": "read", "resource": "pr-context.md", "effect": "allow"},
        {"action": "read", "resource": "index.json", "effect": "allow"},
        {"action": "read", "resource": "files/*.txt", "effect": "allow"},
        {"action": "glob", "resource": "files/*.txt", "effect": "allow"},
        {"action": "external_directory", "resource": "*", "effect": "deny"},
        {"action": "question", "resource": "*", "effect": "deny"},
        {"action": "edit", "resource": "*", "effect": "deny"}
      ]
    }
  }
}
